# ── Auth ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default): sqlite:///./homework.db
# Postgres example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./homework.db

# ── Uploads ──────────────────────────────────────────────────────────────────
# Path is relative to the project root
UPLOAD_DIR=./uploads

# ── Email (OTP delivery via SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
# Cloudflare API token (Bearer) used for the R2 REST API — this is the
# credential actually used by api/utils/r2.py, not an S3 secret key.
TOKEN_VALUE=
# S3-compatible credentials — kept for completeness, not currently used by the app.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_JURISDICTION=
# S3-compatible endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
BUCKET_URL=
# Public dev URL, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# Optional key prefix inside the bucket, e.g. "PCB-books/"
R2_BOOKS_PREFIX=
